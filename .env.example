# ===================================================
# SMART PARKING AI - SYSTEM ENVIRONMENT CONFIGURATION
# ===================================================

# --- Database Configuration (PostgreSQL) ---
POSTGRES_USER=parking_admin
POSTGRES_PASSWORD=parking_password123
POSTGRES_DB=smart_parking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Vector Database Configuration (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=user_faces

# --- Face Recognition Model Configuration ---
FACE_BACKBONE=Facenet512
FACE_VECTOR_SIZE=512
FACE_SIMILARITY_THRESHOLD=0.75
FACE_YELLOW_THRESHOLD=0.50
FACE_DETECTOR=mtcnn

# --- Service Endpoints (Multi-Venv Hybrid Mode) ---
PLATE_API_URL=http://localhost:8001
FACE_API_URL=http://localhost:8002

# --- License Plate Recognition (LPR) Configuration ---
LPR_CONFIDENCE_THRESHOLD=0.5
DEBUG_MODE=True
CAM_INDEX=0

# --- Cloudinary Cloud Storage (Images Archive) ---
# Đăng ký tài khoản miễn phí tại https://cloudinary.com để lấy API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
